# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
PORT=5000
NODE_ENV=development
# Local MongoDB (MongoDB Compass / mongod service)
MONGODB_URI=mongodb://127.0.0.1:27017/dronetv_assistant
# Frontend URL allowed by CORS (Vite default)
CLIENT_ORIGIN=http://localhost:5173
# Secret key for the admin dashboard. Use a long random value.
ADMIN_API_KEY=change-this-to-a-long-random-string
